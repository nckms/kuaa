DATABASE_URL=
REDIS_URL=
JWT_SECRET=
PORT=3333
NODE_ENV=development
FRONTEND_URL=

# Obtenha em aistudio.google.com/apikey. Sem chave, as questões vêm da reserva
# curada (autoral) e o Sabiá informa indisponibilidade.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# SABIA_MODEL=gemini-3.5-flash-lite

# --- Recuperação de senha ---------------------------------------------------
# URL pública do site, sem barra final. Vai nos links enviados por e-mail.
APP_URL=http://localhost:5173
# smtp | memory (só testes) | disabled (padrão: não envia nada)
MAIL_TRANSPORT=disabled
MAIL_FROM="Kuaa <nao-responda@seu-dominio>"
# Desenvolvimento: rode `npm run mail:dev --workspace=apps/api` e use
#   MAIL_TRANSPORT=smtp SMTP_HOST=127.0.0.1 SMTP_PORT=1025
# Produção: credenciais de um provedor SMTP real (não incluídas no repositório).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
PASSWORD_RESET_TTL_MINUTES=30
