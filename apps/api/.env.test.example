# Banco de teste — NUNCA use o banco de produção aqui.
# Opções:
#   1. Mesmo Supabase, schema separado: adicione ?schema=test_vitest à URL
#   2. Outro projeto Supabase (grátis): crie em supabase.com e cole a URL aqui
#   3. Postgres local: postgresql://postgres:postgres@localhost:5432/kuaa_test
DATABASE_URL="postgresql://USER:PASS@HOST:5432/DB?schema=test_vitest&sslmode=require"

JWT_SECRET=kuaa_test_secret_nao_usar_em_producao
PORT=3334
NODE_ENV=test

# Deixar vazio para forçar fallback questions (sem custo de API)
OPENAI_API_KEY=
REDIS_URL=
FRONTEND_URL=http://localhost:5173
