generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
}

enum QuestionSource {
  AI_GENERATED
  CURATED
  OFFICIAL
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  name           String
  school         String?
  city           String?
  state          String?
  avatarUrl      String?
  plan           Plan      @default(FREE)
  xp             Int       @default(0)
  level          Int       @default(1)
  streakDays     Int       @default(0)
  longestStreak  Int       @default(0)
  hearts         Int       @default(5)
  lastActivityAt DateTime?
  emailVerified  Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  enrollments   Enrollment[]
  quizSessions  QuizSession[]
  answers       UserAnswer[]
  achievements  UserAchievement[]
  topicProgress UserTopicProgress[]
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Vestibular {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  institution String
  state       String
  description String
  logoUrl     String?
  year        Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  subjects    Subject[]
  enrollments Enrollment[]
}

model Subject {
  id           String     @id @default(cuid())
  vestibularId String
  name         String
  slug         String
  weight       Float
  order        Int
  iconSlug     String
  vestibular   Vestibular @relation(fields: [vestibularId], references: [id])
  topics       Topic[]
}

model Topic {
  id          String  @id @default(cuid())
  subjectId   String
  name        String
  description String
  order       Int
  xpReward    Int     @default(20)
  subject     Subject @relation(fields: [subjectId], references: [id])

  questions Question[]
  progress  UserTopicProgress[]
  sessions  QuizSession[]
}

model Question {
  id                    String         @id @default(cuid())
  topicId               String
  body                  String
  imageUrl              String?
  options               Json
  explanation           String
  difficulty            Int
  source                QuestionSource @default(AI_GENERATED)
  year                  Int?
  origin                String?
  active                Boolean        @default(true)
  createdAt             DateTime       @default(now())
  generatedForSessionId String?
  topic                 Topic          @relation(fields: [topicId], references: [id])
  generatedForSession   QuizSession?   @relation("SessionGeneratedQuestions", fields: [generatedForSessionId], references: [id], onDelete: SetNull)
  answers               UserAnswer[]

  @@index([generatedForSessionId])
}

model Enrollment {
  id           String     @id @default(cuid())
  userId       String
  vestibularId String
  enrolledAt   DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id])
  vestibular   Vestibular @relation(fields: [vestibularId], references: [id])

  @@unique([userId, vestibularId])
}

model QuizSession {
  id                 String       @id @default(cuid())
  userId             String
  topicId            String
  startedAt          DateTime     @default(now())
  finishedAt         DateTime?
  xpEarned           Int          @default(0)
  correct            Int          @default(0)
  wrong              Int          @default(0)
  skipped            Int          @default(0)
  isPerfect          Boolean      @default(false)
  user               User         @relation(fields: [userId], references: [id])
  topic              Topic        @relation(fields: [topicId], references: [id])
  answers            UserAnswer[]
  generatedQuestions Question[]   @relation("SessionGeneratedQuestions")
}

model UserAnswer {
  id          String      @id @default(cuid())
  userId      String
  questionId  String
  sessionId   String
  optionId    String
  isCorrect   Boolean
  timeSpentMs Int
  answeredAt  DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id])
  question    Question    @relation(fields: [questionId], references: [id])
  session     QuizSession @relation(fields: [sessionId], references: [id])
}

model UserTopicProgress {
  userId        String
  topicId       String
  masteryLevel  Int      @default(0)
  sessionsCount Int      @default(0)
  lastSeenAt    DateTime @default(now())
  unlocked      Boolean  @default(false)
  completed     Boolean  @default(false)
  user          User     @relation(fields: [userId], references: [id])
  topic         Topic    @relation(fields: [topicId], references: [id])

  @@id([userId, topicId])
}

model Achievement {
  id          String            @id @default(cuid())
  slug        String            @unique
  name        String
  description String
  iconSlug    String
  xpBonus     Int               @default(0)
  unlocks     UserAchievement[]
}

model UserAchievement {
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id])
  achievement   Achievement @relation(fields: [achievementId], references: [id])

  @@id([userId, achievementId])
}
