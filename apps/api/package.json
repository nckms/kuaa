{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "npx prisma generate && tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint . --ext .ts --report-unused-disable-directives --max-warnings 0",
    "mail:dev": "ts-node --transpile-only scripts/dev-mailbox.ts",
    "test:local": "node scripts/test-local.mjs",
    "test:backup": "node scripts/verify-backup.mjs",
    "metrics": "node scripts/metrics.mjs",
    "grant-plus": "node scripts/grant-plus.mjs",
    "weekly-email": "ts-node --transpile-only scripts/weekly-email.ts",
    "db:migrate": "node scripts/reconcile-migrations.mjs && prisma migrate deploy"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^8.37.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^6.10.1",
    "stripe": "^23.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mailparser": "^3.9.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.9.1",
    "@types/nodemailer": "^6.4.24",
    "@types/smtp-server": "^3.5.13",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "eslint": "^9.14.0",
    "mailparser": "^3.14.3",
    "prettier": "^3.3.3",
    "prisma": "^5.22.0",
    "smtp-server": "^3.21.4",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
