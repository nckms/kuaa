generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  PLUS
}

enum QuestionSource {
  AI_GENERATED
  CURATED
  OFFICIAL
}

enum EssayStatus {
  DRAFT
  SUBMITTED
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  name               String
  school             String?
  city               String?
  state              String?
  avatarUrl          String?
  plan               Plan      @default(FREE)
  planExpiresAt      DateTime?
  stripeCustomerId   String?   @unique
  /// Código do link de convite ("?convite="), criado sob demanda.
  referralCode       String?   @unique
  referredById       String?
  referredBy         User?     @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals          User[]    @relation("Referrals")
  /// Origem do cadastro (primeiro toque): ref, utm_*, domínio de referência. Sem dados pessoais.
  signupSource       Json?
  xp                 Int       @default(0)
  level              Int       @default(1)
  streakDays         Int       @default(0)
  longestStreak      Int       @default(0)
  hearts             Int       @default(5)
  lastActivityAt     DateTime?
  emailVerified      Boolean   @default(false)
  preferences        Json      @default("{}")
  activeVestibularId String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  enrollments          Enrollment[]
  quizSessions         QuizSession[]
  answers              UserAnswer[]
  achievements         UserAchievement[]
  topicProgress        UserTopicProgress[]
  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]
  indexSnapshots       IndexSnapshot[]
  simuladoAttempts     SimuladoAttempt[]
  usabilityEvaluation  UsabilityEvaluation?
  sabiaMessages        SabiaMessage[]
  sabiaConversations   SabiaConversation[]
  essays               EssayDraft[]
  planGrants           PlanGrant[]
  pushSubscriptions    PushSubscription[]
  productSignals       ProductSignal[]
  examAttempts         ExamAttempt[]
  reviewItems          ReviewItem[]
  emailLogs            EmailLog[]
  subscriptions        Subscription[]
  studentVerifications StudentVerification[]
  Guardian             Guardian?
  EssayCorrection      EssayCorrection[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Token de redefinicao de senha. Somente o hash SHA-256 e armazenado;
/// o valor bruto existe apenas no link enviado por e-mail.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Vestibular {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  institution String
  state       String
  description String
  logoUrl     String?
  year        Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  subjects         Subject[]
  enrollments      Enrollment[]
  indexSnapshots   IndexSnapshot[]
  simuladoAttempts SimuladoAttempt[]
  essays           EssayDraft[]
}

model EssayDraft {
  id                  String           @id @default(cuid())
  userId              String
  vestibularId        String
  themeId             String
  themeTitle          String
  prompt              String
  textType            String
  body                String           @default("") @db.Text
  selfReview          Json             @default("{}")
  feedback            Json?
  feedbackRequestedAt DateTime?
  aiConsentAt         DateTime?
  status              EssayStatus      @default(DRAFT)
  submittedAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  vestibular          Vestibular       @relation(fields: [vestibularId], references: [id])
  correction          EssayCorrection?

  @@index([userId, createdAt])
}

model Subject {
  id           String     @id @default(cuid())
  vestibularId String
  name         String
  slug         String
  weight       Float
  order        Int
  iconSlug     String
  vestibular   Vestibular @relation(fields: [vestibularId], references: [id])
  topics       Topic[]

  @@unique([vestibularId, slug])
}

model Topic {
  id          String  @id @default(cuid())
  subjectId   String
  name        String
  description String
  order       Int
  xpReward    Int     @default(20)
  subject     Subject @relation(fields: [subjectId], references: [id])

  questions Question[]
  progress  UserTopicProgress[]
  sessions  QuizSession[]

  @@unique([subjectId, order])
}

model Question {
  id                    String         @id @default(cuid())
  topicId               String
  body                  String
  imageUrl              String?
  media                 Json?
  options               Json
  explanation           String
  difficulty            Int
  source                QuestionSource @default(AI_GENERATED)
  year                  Int?
  origin                String?
  active                Boolean        @default(true)
  createdAt             DateTime       @default(now())
  generatedForSessionId String?
  /// Cópia de sessão de uma questão oficial: id da questão oficial de origem.
  officialRefId         String?
  /// Explicação escrita por IA (questões oficiais não trazem explicação).
  explanationByAi       Boolean        @default(false)
  /// Como o tópico da questão oficial foi definido: null = palavras-chave; "ai" = classificada pela IA.
  topicSource           String?
  /// Origem da dificuldade da questão oficial: null = ainda sem estimativa; "ai" = estimada pela IA.
  difficultySource      String?
  topic                 Topic          @relation(fields: [topicId], references: [id])
  generatedForSession   QuizSession?   @relation("SessionGeneratedQuestions", fields: [generatedForSessionId], references: [id], onDelete: SetNull)
  answers               UserAnswer[]

  @@index([generatedForSessionId])
  @@index([officialRefId])
  @@index([source, topicId])
}

model Enrollment {
  id           String     @id @default(cuid())
  userId       String
  vestibularId String
  enrolledAt   DateTime   @default(now())
  diagnostic   Json?
  user         User       @relation(fields: [userId], references: [id])
  vestibular   Vestibular @relation(fields: [vestibularId], references: [id])

  @@unique([userId, vestibularId])
}

model QuizSession {
  id                 String       @id @default(cuid())
  userId             String
  topicId            String
  startedAt          DateTime     @default(now())
  finishedAt         DateTime?
  xpEarned           Int          @default(0)
  correct            Int          @default(0)
  wrong              Int          @default(0)
  skipped            Int          @default(0)
  isPerfect          Boolean      @default(false)
  /// Sessão de revisão do caderno de erros: não conta na cota diária de práticas.
  isReview           Boolean      @default(false)
  generationMetadata Json?
  user               User         @relation(fields: [userId], references: [id])
  topic              Topic        @relation(fields: [topicId], references: [id])
  answers            UserAnswer[]
  generatedQuestions Question[]   @relation("SessionGeneratedQuestions")
}

model UserAnswer {
  id          String      @id @default(cuid())
  userId      String
  questionId  String
  sessionId   String
  optionId    String
  isCorrect   Boolean
  timeSpentMs Int
  answeredAt  DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id])
  question    Question    @relation(fields: [questionId], references: [id])
  session     QuizSession @relation(fields: [sessionId], references: [id])
}

model UserTopicProgress {
  userId        String
  topicId       String
  masteryLevel  Int      @default(0)
  sessionsCount Int      @default(0)
  lastSeenAt    DateTime @default(now())
  unlocked      Boolean  @default(false)
  completed     Boolean  @default(false)
  user          User     @relation(fields: [userId], references: [id])
  topic         Topic    @relation(fields: [topicId], references: [id])

  @@id([userId, topicId])
}

model Achievement {
  id          String            @id @default(cuid())
  slug        String            @unique
  name        String
  description String
  iconSlug    String
  xpBonus     Int               @default(0)
  unlocks     UserAchievement[]
}

model IndexSnapshot {
  id            String     @id @default(cuid())
  userId        String
  vestibularId  String
  score         Int
  subjectScores Json
  capturedAt    DateTime   @default(now())
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vestibular    Vestibular @relation(fields: [vestibularId], references: [id], onDelete: Cascade)

  @@index([userId, vestibularId, capturedAt])
}

model SimuladoAttempt {
  id           String     @id @default(cuid())
  userId       String
  vestibularId String
  weekStart    DateTime
  questions    Json
  answers      Json       @default("{}")
  flagged      Json       @default("[]")
  startedAt    DateTime   @default(now())
  finishedAt   DateTime?
  score        Int?
  correct      Int?
  wrong        Int?
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vestibular   Vestibular @relation(fields: [vestibularId], references: [id], onDelete: Cascade)

  @@unique([userId, vestibularId, weekStart])
  @@index([userId, vestibularId])
}

model UserAchievement {
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id])
  achievement   Achievement @relation(fields: [achievementId], references: [id])

  @@id([userId, achievementId])
}

model UsabilityEvaluation {
  id        String   @id @default(cuid())
  userId    String   @unique
  answers   Json
  score     Float
  feedback  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SabiaMessage {
  id             String             @id @default(cuid())
  userId         String
  role           String
  content        String
  createdAt      DateTime           @default(now())
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   SabiaConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([conversationId, createdAt])
}

model SabiaConversation {
  id        String         @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  SabiaMessage[]

  @@index([userId, updatedAt])
}

model PlanGrant {
  id        String   @id @default(cuid())
  userId    String
  plan      Plan
  expiresAt DateTime
  source    String
  reference String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([source, reference])
  @@index([userId, createdAt])
}

model EmailLog {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  periodKey String
  sentAt    DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, periodKey])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  stripeSubscriptionId String    @unique
  status               String
  priceKind            String
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StudentVerification {
  id           String    @id @default(cuid())
  userId       String
  status       String
  documentData Bytes?
  documentMime String?
  rejectReason String?
  submittedAt  DateTime  @default(now())
  reviewedAt   DateTime?
  expiresAt    DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, submittedAt])
  @@index([userId, submittedAt])
}

/// Inscrição de notificação (Web Push) de um navegador/app instalado do aluno.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  endpoint   String    @unique
  p256dh     String
  auth       String
  createdAt  DateTime  @default(now())
  lastSentAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Sinais de produto sem dado sensível: bateu na cota do gratuito (1x/dia por
/// cota) e pediu aviso da abertura do Plus. Base da medição de intenção de compra.
model ProductSignal {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  periodKey String
  source    String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, periodKey])
  @@index([kind, createdAt])
}

/// Prova anterior completa (ex.: ENEM 2022, dia 1), feita com as questões oficiais.
model ExamAttempt {
  id              String    @id @default(cuid())
  userId          String
  exam            String
  year            Int
  day             Int
  language        String?
  questionIds     Json
  answers         Json      @default("{}")
  flagged         Json      @default("[]")
  durationSeconds Int
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  correct         Int?
  wrong           Int?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, exam, year, day])
}

/// Caderno de erros: cada questão errada volta para revisão (1 dia, depois 3) até dois acertos seguidos.
model ReviewItem {
  id               String    @id @default(cuid())
  userId           String
  /// Questão oficial: id canônico (cofenem…); outras: id da cópia em que o aluno errou.
  questionKey      String
  /// Questão de onde vem o conteúdo da revisão.
  sourceQuestionId String
  topicId          String
  correctStreak    Int       @default(0)
  timesWrong       Int       @default(1)
  dueAt            DateTime
  lastWrongAt      DateTime  @default(now())
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionKey])
  @@index([userId, resolvedAt, dueAt])
}

/// Responsável do aluno: recebe por e-mail o resumo mensal depois de confirmar o endereço.
model Guardian {
  id               String    @id @default(cuid())
  userId           String    @unique
  email            String
  /// SHA-256 do token de confirmação (o token só vai no e-mail).
  confirmTokenHash String    @unique
  /// Quando o convite saiu. Nulo = ainda não saiu (envio de e-mail desligado); o agendador manda depois.
  inviteSentAt     DateTime?
  confirmedAt      DateTime?
  unsubscribedAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Correção completa por competência do ENEM (Kuaa Plus). Uma por redação enviada.
model EssayCorrection {
  id        String     @id @default(cuid())
  essayId   String     @unique
  userId    String
  /// pending enquanto a IA corrige; done com o resultado.
  status    String     @default("pending")
  total     Int?
  result    Json?
  rewrites  Json       @default("[]")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  essay     EssayDraft @relation(fields: [essayId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
